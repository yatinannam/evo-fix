# Local frontend configuration template. Copy to .env or .env.local and fill in your values.
# This file is committed to Git and must never contain real secret keys or browser-exposed secrets.
NEXT_PUBLIC_SUPABASE_URL=https:
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local Express API and the origin that hosts public secure-share links.
NEXT_PUBLIC_API_URL=https://api.evodev.site
NEXT_PUBLIC_SHARE_BASE_URL=https://www.evodoc.in

# Used only by the server-side /evodoc/api/signup route. Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── emp-dash: dedicated Supabase project (never share with the vars above) ──
NEXT_PUBLIC_EMPDASH_SUPABASE_URL=https://your-empdash-project.supabase.co
NEXT_PUBLIC_EMPDASH_SUPABASE_ANON_KEY=your_empdash_anon_key_here
# Server-side only — no NEXT_PUBLIC_ prefix — never expose to the browser
EMPDASH_SUPABASE_SERVICE_ROLE_KEY=your_empdash_service_role_key_here
